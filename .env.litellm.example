# Copy this file to .env.litellm and fill in the values. .env.litellm is git-ignored.

# LiteLLM proxy auth — also entered as the API Key in the app Settings.
LITELLM_MASTER_KEY=sk-he-tracker-local

# Azure OpenAI backend. The deployment name goes in litellm/litellm_config.yaml
# (model: azure/<deployment>); only the endpoint, key, and version are secrets.
AZURE_API_BASE=https://<your-resource>.openai.azure.com
AZURE_API_KEY=<your-azure-key>
AZURE_API_VERSION=2024-02-15-preview

# Corporate (Netskope) CA chain, base64-encoded. Consumed as docker build args
# so the container trusts the TLS-inspection chain for outbound HTTPS to Azure.
# Reuse the values from the Polaris .env. Leave blank when off the corporate network.
NETSKOPE_ROOT_CA_B64=
NETSKOPE_TENANT_CA_B64=
